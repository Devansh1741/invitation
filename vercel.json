{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/groom",
      "permanent": true
    },
    {
      "source": "/wedding",
      "destination": "/bride",
      "permanent": true
    },
    {
      "source": "/pre-wedding",
      "destination": "/other",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}